<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingCriteriaRules>
        <fullName>Corporate_Clients_Public_Read_Write</fullName>
        <accessLevel>Edit</accessLevel>
        <accountSettings>
            <caseAccessLevel>Edit</caseAccessLevel>
            <contactAccessLevel>Edit</contactAccessLevel>
            <opportunityAccessLevel>Edit</opportunityAccessLevel>
        </accountSettings>
        <description>Restores Public Read/Write access to Corporate Client Accounts after OWD was set to Private. Corporate clients don&apos;t need the same privacy restrictions as Private Clients.</description>
        <label>Corporate Clients - Public Read/Write</label>
        <sharedTo>
            <allInternalUsers></allInternalUsers>
        </sharedTo>
        <criteriaItems>
            <field>RecordTypeId</field>
            <operation>equals</operation>
            <value>Corporate Client</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>Private_Clients_Standard_Sensitivity</fullName>
        <accessLevel>Edit</accessLevel>
        <accountSettings>
            <caseAccessLevel>None</caseAccessLevel>
            <contactAccessLevel>Edit</contactAccessLevel>
            <opportunityAccessLevel>None</opportunityAccessLevel>
        </accountSettings>
        <description>Grants access to Standard (non-High-Profile) Private Clients to Event Owners, their managers, and the Social Events team. Implements BRD SE-005 FR#1.</description>
        <label>Private Clients - Standard Sensitivity</label>
        <sharedTo>
            <group>Private_Events_Team</group>
        </sharedTo>
        <criteriaItems>
            <field>RecordTypeId</field>
            <operation>equals</operation>
            <value>Private Client</value>
        </criteriaItems>
        <criteriaItems>
            <field>Data_Sensitivity_Flag__c</field>
            <operation>equals</operation>
            <value>Standard</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
</SharingRules>
