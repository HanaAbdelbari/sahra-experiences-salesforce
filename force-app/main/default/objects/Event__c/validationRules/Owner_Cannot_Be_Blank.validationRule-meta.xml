<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Owner_Cannot_Be_Blank</fullName>
    <active>true</active>
    <errorConditionFormula>ISBLANK(OwnerId)</errorConditionFormula>
    <errorDisplayField>OwnerId</errorDisplayField>
    <errorMessage>An Event must always have an assigned Event Owner.</errorMessage>
</ValidationRule>
