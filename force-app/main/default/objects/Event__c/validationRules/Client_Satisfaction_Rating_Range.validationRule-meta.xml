<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Client_Satisfaction_Rating_Range</fullName>
    <active>true</active>
    <description>Client Satisfaction Rating must be 1–5 only</description>
    <errorConditionFormula>AND(
  NOT(ISBLANK(Client_Satisfaction__c)),
  OR(
    Client_Satisfaction__c &lt; 1,
    Client_Satisfaction__c &gt; 5
  )
)</errorConditionFormula>
    <errorDisplayField>Client_Satisfaction__c</errorDisplayField>
    <errorMessage>Client Satisfaction Rating must be between 1 and 5</errorMessage>
</ValidationRule>
