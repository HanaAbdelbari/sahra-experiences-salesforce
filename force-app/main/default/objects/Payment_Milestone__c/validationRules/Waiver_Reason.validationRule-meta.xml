<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Waiver_Reason</fullName>
    <active>true</active>
    <description>Waiver Reason required before setting Waived</description>
    <errorConditionFormula>AND(ISPICKVAL(Status__c,&apos;Waived&apos;), ISBLANK(Waiver_Reason__c))</errorConditionFormula>
    <errorDisplayField>Waiver_Reason__c</errorDisplayField>
    <errorMessage>Waiver Reason is required before waiving a milestone</errorMessage>
</ValidationRule>
