<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Other_Dietary_Restrictions_Selected</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
  INCLUDES( Dietary__c , &quot;Other&quot;),
  ISBLANK(Other_Dietary_Notes__c)
)</errorConditionFormula>
    <errorDisplayField>Other_Dietary_Notes__c</errorDisplayField>
    <errorMessage>Please specify the dietary restriction in the 
&quot;Other Dietary Notes&quot; field when selecting &quot;Other&quot;.</errorMessage>
</ValidationRule>
