<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Sales_Start_Within_Event_Window</fullName>
    <active>true</active>
    <errorConditionFormula>Sales_Start__c &lt; Event__r.Sales_Open_Date__c</errorConditionFormula>
    <errorDisplayField>Sales_Start__c</errorDisplayField>
    <errorMessage>Sales Start Date cannot be before the Event&apos;s Sales Open Date</errorMessage>
</ValidationRule>
