<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Held_Qty_Max_Five_Percent</fullName>
    <active>true</active>
    <errorConditionFormula>Qty_Held__c &gt; (Qty_Available__c * 0.05)</errorConditionFormula>
    <errorDisplayField>Qty_Held__c</errorDisplayField>
    <errorMessage>Held quantity cannot exceed 5% of Quantity Available</errorMessage>
</ValidationRule>
